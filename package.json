{
  "name": "hibernate-express",
  "private": true,
  "version": "1.0.0",
  "description": "Sleep peacefully on the bus. Hibernate Express tracks your live GPS against the real road route and rings a loud alarm before your stop.",
  "type": "module",
  "license": "MIT",
  "author": "Sachin Chauhan",
  "repository": {
    "type": "git",
    "url": "https://github.com/chauhansachin13/hibernate-express.git"
  },
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.test.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "accuracy": "HX_WRITE_REPORT=1 vitest run tests/accuracy.test.ts",
    "icons": "node scripts/generate-icons.mjs"
  },
  "dependencies": {
    "@fontsource-variable/manrope": "^5.3.0",
    "@fontsource/barlow-condensed": "^5.3.0",
    "leaflet": "^1.9.4"
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^24.19.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  }
}
